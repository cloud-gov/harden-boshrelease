#!/bin/bash
set -e

echo "---> Starting hardening process"

JOB_DIR=/var/vcap/jobs/harden

# Make all apt/dpkg calls in this script non-interactive and force local
# conffile changes (e.g. our /etc/issue banner) to win over package defaults
# without prompting. Without this, any apt-get call below that pulls in a
# package whose conffile we've customized (base-files -> /etc/issue, etc.)
# will block forever waiting on a stdin prompt with no TTY attached, and the
# post-deploy script will fail. See harden-boshrelease noble-main notes.
export DEBIAN_FRONTEND=noninteractive
APT_CONFFILE_OPTS=(-o Dpkg::Options::="--force-confold" -o Dpkg::Options::="--force-confdef")

###
# APT sources: the allow-listed mirrors. Required before any apt-get below --
# ADR-0002 specifies cracklib-runtime must come from an allow-listed mirror
# (us-gov-west-1 archive), not an arbitrary source (CM-7, supply chain).
###

cp "${JOB_DIR}/files/etc/apt/sources.list.d/aws-ubuntu-mirrors.list" /etc/apt/sources.list.d/aws-ubuntu-mirrors.list
chmod 0644 /etc/apt/sources.list.d/aws-ubuntu-mirrors.list
chown root:root /etc/apt/sources.list.d/aws-ubuntu-mirrors.list

###
# Continuous security-only patching config. Must land BEFORE installing
# unattended-upgrades below -- installing the package without this config
# would enable automatic upgrades under distro defaults rather than the
# -security-pocket-only scope this baseline is validated against.
###

mkdir -p /etc/apt/apt.conf.d
cp "${JOB_DIR}/files/etc/apt/apt.conf.d/51unattended-upgrades-security" /etc/apt/apt.conf.d/51unattended-upgrades-security
cp "${JOB_DIR}/files/etc/apt/apt.conf.d/20auto-upgrades" /etc/apt/apt.conf.d/20auto-upgrades
chmod 0644 /etc/apt/apt.conf.d/51unattended-upgrades-security /etc/apt/apt.conf.d/20auto-upgrades
chown root:root /etc/apt/apt.conf.d/51unattended-upgrades-security /etc/apt/apt.conf.d/20auto-upgrades

###
# Make every apt invocation on this box WAIT for the dpkg lock rather than
# exit non-zero. This must land before the first apt-get below, and it is the
# only way to influence the apt calls that happen INSIDE `usg fix` (its
# package_* rule remediations shell out to apt themselves).
#
# See the file's own comment for the full rationale: without it, the first
# deploy of a release fails here and an identical second deploy succeeds.
###

cp "${JOB_DIR}/files/etc/apt/apt.conf.d/99bosh-lock-timeout" /etc/apt/apt.conf.d/99bosh-lock-timeout
chmod 0644 /etc/apt/apt.conf.d/99bosh-lock-timeout
chown root:root /etc/apt/apt.conf.d/99bosh-lock-timeout

###
# Belt-and-braces: explicitly wait out any apt work already in flight before
# we start our own. DPkg::Lock::Timeout above handles the common case, but a
# long-running apt-daily download can exceed it, and failing here with a clear
# message beats failing later inside usg fix with an opaque one.
###

wait_for_apt_lock() {
  local timeout=900 elapsed=0
  while fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 \
     || fuser /var/lib/apt/lists/lock  >/dev/null 2>&1; do
    if (( elapsed >= timeout )); then
      echo "ERROR: dpkg/apt lock still held after ${timeout}s; aborting." >&2
      echo "Holder(s):" >&2
      fuser -v /var/lib/dpkg/lock-frontend >&2 2>&1 || true
      return 1
    fi
    if (( elapsed % 30 == 0 )); then
      echo "---> Waiting for another apt/dpkg process to finish (${elapsed}s elapsed)"
    fi
    sleep 5
    elapsed=$(( elapsed + 5 ))
  done
  return 0
}

wait_for_apt_lock

apt-get update

###
# cracklib dictionary -- REQUIRED for pam_pwquality dictcheck.
#
# See ADR-0002 (0002-cracklib-runtime-required-harden-dependency-noble.md):
# the Noble stemcell ships no cracklib, but pam_pwquality's dictcheck loads
# /var/cache/cracklib/cracklib_dict.pwd. Without it the requisite pwquality
# module fails and EVERY password change on the box fails with
# "Authentication token manipulation error" -- promotion-blocking.
#
# This is NOT the removed libpam-cracklib PAM module (correctly gone in PAM
# 1.5.0; this release uses the modern pam_pwquality). It is the separate
# cracklib-runtime package that BUILDS the dictionary dictcheck needs.
#
# Must run BEFORE `usg fix` below, because the STIG tailoring leaves
# accounts_password_pam_dictcheck enabled -- usg fix will write dictcheck=1
# into pwquality.conf, so the dictionary has to already exist.
# ADR-0002 explicitly REJECTED dictcheck=0 as a workaround.
###

apt-get "${APT_CONFFILE_OPTS[@]}" install -y cracklib-runtime
update-cracklib || true

###
# Continuous security-only patching: install unattended-upgrades. The config
# dropped in above scopes it to the -security pocket only.
#
# NOTE: the timers are deliberately NOT started here (no `--now`). Both
# apt-daily.timer and apt-daily-upgrade.timer ship with Persistent=true, so
# `systemctl enable --now` on a VM where they have never run makes systemd fire
# a catch-up run IMMEDIATELY, taking the dpkg lock mid-deploy. That was not the
# cause of the observed post-deploy failure (see the LOCK CONTENTION note
# below -- that was /run/lock/usg.lock, not dpkg), but starting daily
# maintenance timers during a deploy is a latent hazard regardless, so they are
# enabled (firing on their OnCalendar schedule) rather than started, and the
# enable happens after all of our own apt work.
###

apt-get "${APT_CONFFILE_OPTS[@]}" install -y unattended-upgrades

###
# STIG remediation via Ubuntu Security Guide.
#
# No profile argument is given: usg rejects a positional profile when
# --tailoring-file is supplied ("You cannot provide both a tailoring file and
# a profile!"). The tailoring file itself declares the benchmark channel
# (ubuntu2404_STIG_1) and the customized profile.
#
# The tailoring file is generated from tools/tailor-convert/ -- see
# tools/tailor-convert/README.md. Do not hand-edit it.
#
# LOCK CONTENTION -- root cause of "first deploy fails, second succeeds":
#
# BOSH runs the post-deploy script of EVERY job on the instance in PARALLEL
# (bosh-agent ConcreteJobScriptProvider.NewParallelScript -- hence the director
# error "1 of 2 post-deploy scripts failed"). usg serialises itself with a
# single global flock on /run/lock/usg.lock and does NOT wait for it: it exits
# non-zero immediately with
#     Failed to acquire lock /run/lock/usg.lock. Is another instance of USG running?
#
# Historically this job's `usg fix` raced a `usg audit` in the
# ubuntu-advantage-pro-token job's post-deploy, and whichever started second
# died; on a redeploy the timing differed and it happened to succeed, which is
# why it looked intermittent. That audit has since been REMOVED from the
# sibling job and replaced by the on-demand `harden-audit` errand job, so
# `usg fix` should now be the only usg invocation during a deploy.
#
# The wait-and-retry below is kept anyway: it is cheap, and it still protects
# against the harden-audit errand (or `usg` by hand) running while a deploy is in
# flight. We deliberately do NOT wrap usg in `flock` ourselves -- usg opens the
# lock file itself, creating a separate open file description, so an outer
# flock would conflict with usg's own acquisition rather than protect it.
###

# Returns 0 as soon as no other process holds /run/lock/usg.lock.
usg_lock_wait() {
  local timeout="${1:-900}" elapsed=0 interval=5
  while :; do
    # Probe with a non-blocking exclusive flock on our own fd. If we get it,
    # nothing else holds the lock; we release it immediately by closing the fd.
    if ( exec 9>>/run/lock/usg.lock && flock --nonblock --exclusive 9 ) 2>/dev/null; then
      return 0
    fi
    if (( elapsed >= timeout )); then
      echo "ERROR: /run/lock/usg.lock still held after ${timeout}s." >&2
      if command -v fuser >/dev/null 2>&1; then
        echo "Lock holder(s):" >&2
        fuser -v /run/lock/usg.lock >&2 2>&1 || true
      fi
      return 1
    fi
    if (( elapsed % 30 == 0 )); then
      echo "---> Waiting for another usg instance to release /run/lock/usg.lock (${elapsed}s elapsed)"
    fi
    sleep "${interval}"
    elapsed=$(( elapsed + interval ))
  done
}

echo "Job DIR is ${JOB_DIR}"

usg_fix_with_retry() {
  local attempts=5 attempt=1
  while (( attempt <= attempts )); do
    usg_lock_wait 900 || return 1
    if usg fix --tailoring-file "${JOB_DIR}/files/tailor.xml"; then
      return 0
    fi
    # usg exits non-zero both for a lost lock race and for genuine remediation
    # errors. Only the lock race is worth retrying, and it is self-limiting.
    if (( attempt == attempts )); then
      echo "ERROR: 'usg fix' failed after ${attempts} attempts." >&2
      return 1
    fi
    echo "---> 'usg fix' failed (attempt ${attempt}/${attempts}); retrying in 15s" >&2
    sleep 15
    attempt=$(( attempt + 1 ))
  done
}

usg_fix_with_retry

###
# Remove the auditd package fragment containing legacy auid>=500 rules.
# USG generates the current rules in separate *.rules fragments.
###
LEGACY_AUDIT_RULES=/etc/audit/rules.d/audit.rules

if [[ -f "${LEGACY_AUDIT_RULES}" ]]; then
  mv -f "${LEGACY_AUDIT_RULES}" \
    "${LEGACY_AUDIT_RULES}.disabled"
fi

install -o root -g root -m 0600 \
  "${JOB_DIR}/files/etc/audit/rules.d/00-audit-control.rules" \
  /etc/audit/rules.d/00-audit-control.rules

install -o root -g root -m 0600 \
  "${JOB_DIR}/files/etc/audit/rules.d/05-bosh-baseline.rules" \
  /etc/audit/rules.d/05-bosh-baseline.rules

# Rebuild from the active fragments after removing the legacy fragment.
rm -f /etc/audit/audit.rules
if ! augenrules --load; then
  echo "ERROR: augenrules failed. Generated rules, with line numbers:" >&2
  nl -ba /etc/audit/audit.rules >&2
  echo "ERROR: duplicate active source rules, with fragment locations:" >&2
  while IFS= read -r duplicate_rule; do
    grep -nHF -- "${duplicate_rule}" /etc/audit/rules.d/*.rules >&2
  done < <(
    awk '!/^($|#)/ { count[$0]++ } END { for (rule in count) if (count[rule] > 1) print rule }' \
      /etc/audit/rules.d/*.rules
  )
  exit 1
fi

# Fail closed if legacy rules remain in active input fragments.
if find /etc/audit/rules.d -maxdepth 1 -type f -name '*.rules' \
  -print0 | xargs -0 grep -qs 'auid>=500'; then
  echo "ERROR: active audit rule fragments still contain auid>=500." >&2
  find /etc/audit/rules.d -maxdepth 1 -type f -name '*.rules' \
    -print0 | xargs -0 grep -nH 'auid>=500' >&2
  exit 1
fi



###
# Enable the daily patching timers now that all of our own apt work is done.
# No `--now`: see the unattended-upgrades note above -- Persistent=true means
# starting them here would trigger an immediate catch-up run. Enabling alone
# is sufficient; they will fire on their OnCalendar schedule.
###

systemctl enable apt-daily.timer apt-daily-upgrade.timer

###
# AIDE database refresh. AIDE itself is installed/managed by the separate
# aide-boshrelease (which is why the AIDE STIG rules are disabled in the
# tailoring file); this only refreshes its database after usg fix has
# changed files on disk, so the next integrity check is not all noise.
###

if [[ -f /var/vcap/jobs/aide/bin/update-aide-db ]]; then
  echo "---> Updating AIDE db"
  set +e # aide returns non-zero on db changes
  /var/vcap/jobs/aide/bin/update-aide-db
  set -e
fi

echo "---> Hardening process finished"
