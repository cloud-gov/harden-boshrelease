// Managed by fisma-noble harden job. Security pocket ONLY -- do not add
// ${distro_id}:${distro_codename}-updates or -backports here; this
// release's baseline is validated against -security only.
Unattended-Upgrade::Allowed-Origins {
    "${distro_id}:${distro_codename}-security";
};

// Do not auto-reboot. A reboot changes the running kernel/services outside
// of a BOSH-tracked deploy/recreate. Kernel-class fixes remain a
// "System Restart Required" Nessus Info finding until the next
// deploy/recreate cycle -- this is a known, accepted residual.
Unattended-Upgrade::Automatic-Reboot "false";

// Keep logs -- this is the audit trail for SI-2 evidence.
Unattended-Upgrade::SyslogEnable "true";

// Pin-safety: packages listed here are NEVER auto-upgraded by this
// mechanism, even if a -security fix is available. A real APT pin
// (/etc/apt/preferences.d/) already takes precedence over unattended-upgrades
// with no extra config -- this list is for cases where you want an upgrade
// to require an explicit human/release decision without setting up a full
// pin-priority file. Empty by default; add package names as needed, e.g.:
// Unattended-Upgrade::Package-Blacklist {
//     "openssh-server";
// };
Unattended-Upgrade::Package-Blacklist {
};
