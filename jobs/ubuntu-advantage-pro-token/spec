---
name: ubuntu-advantage-pro-token

templates:
  drain.sh: bin/drain
  pre-start.sh: bin/pre-start

packages: []

properties:
  ubuntu_advantage_pro_token:
    description: "The Ubuntu subscription token (available on the Ubuntu pro dashboard)."
  stig_profile:
    description: "usg STIG profile name to audit against."
    default: "stig-v1r1"
  require_fips:
    description: "Fail pre-start if a FIPS kernel is not active. Set false on non-FIPS stemcells (e.g. ubuntu-noble, which has no FIPS variant)."
    default: true

